{
  "name": "file-tree-generator",
  "displayName": "file-tree-generator",
  "description": "This is a plugin that helps create a file tree for a directory.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "file-tree-generator.generateTree",
        "title": "Generate file-tree"
      }
    ],
    "configuration": {
      "title": "File Tree Generator",
      "properties": {
        "file-tree-generator.mode": {
          "type": "string",
          "enum": ["all", "folders-only", "files-only"],
          "default": "all",
          "description": "Что включать в дерево: всё, только папки или только файлы."
        },
        "file-tree-generator.includeHidden": {
          "type": "boolean",
          "default": false,
          "description": "Показывать скрытые файлы и папки (начинающиеся с точки)."
        },
        "file-tree-generator.maxDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Глубина рекурсии. 0 означает без ограничений."
        },
        "file-tree-generator.excludedDirs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["node_modules", ".git", "dist", "build"],
          "description": "Имена папок, которые нужно пропускать."
        },
        "file-tree-generator.excludedExts": {
          "type": "array",
          "items": { "type": "string" },
          "default": [".log", ".map"],
          "description": "Расширения файлов, которые нужно пропускать (например, .log, .map)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "ts-loader": "^9.6.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
